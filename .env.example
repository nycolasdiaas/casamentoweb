# Copie para .env.local e preencha com valores reais. NUNCA commite
# .env.local nem .env — só este arquivo de exemplo entra no git.

# Postgres (Supabase). DATABASE_URL_DIRECT é opcional (migrações preferem
# conexão direta, sem pooler); sem ela, cai para DATABASE_URL.
DATABASE_URL=
DATABASE_URL_DIRECT=
# Usado só pelos testes automatizados — pode apontar pro mesmo banco acima
# (os testes rodam num schema Postgres isolado, "test").
DATABASE_URL_TEST=

# Segredo usado para assinar os cookies de sessão (admin e casal). Gere um
# valor aleatório forte, ex: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar este valor derruba todas as sessões ativas (login de novo).
ADMIN_SESSION_SECRET=

# AbacatePay (pagamento PIX). Chave do painel AbacatePay — use uma chave de
# teste (abc_dev_...) em desenvolvimento, nunca a de produção fora da Vercel.
ABACATEPAY_API_KEY=
# Opcional: mesmo valor configurado no webhook do painel AbacatePay.
ABACATEPAY_WEBHOOK_SECRET=

# Em produção, defina a URL pública (ex: https://enlace.com.br) para os
# links de retorno do pagamento e de redefinição de senha.
NEXT_PUBLIC_SITE_URL=

# --- Envio de e-mail (redefinição de senha + confirmação de cadastro) ---
# Dois transportes possíveis. Sem nenhum dos dois, o envio fica desligado:
# o "esqueci minha senha" aponta para o WhatsApp e a confirmação de e-mail
# não bloqueia o envio do pedido.

# 1) Gmail SMTP — temporário, não precisa de domínio próprio. Tem
# prioridade sobre o Resend quando preenchido. GMAIL_APP_PASSWORD é uma
# "Senha de app" (16 letras) gerada em myaccount.google.com/apppasswords,
# NÃO a senha normal da conta — exige verificação em 2 etapas ativa.
# Limite de ~500 destinatários/dia. Teste com:
#   node scripts/test-email.mjs seu@email.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Nome que aparece como remetente (padrão "Enlace").
MAIL_FROM_NAME=

# 2) Resend — destino final, exige domínio verificado (SPF/DKIM).
# RESET_EMAIL_FROM precisa usar esse domínio
# (ex: "Enlace <nao-responda@enlace.com.br>").
RESEND_API_KEY=
RESET_EMAIL_FROM=

# Upload de fotos do casal — Supabase Storage. O bucket precisa ser
# PRIVADO (as fotos são lidas por URL assinada temporária). Sem estas
# variáveis o formulário mostra aviso e o casal cai no link externo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: nome do bucket (padrão "order-photos").
SUPABASE_PHOTOS_BUCKET=

# Links de prévia e de produção sugeridos automaticamente no admin
# (lib/orderLinks.ts). Opcionais — têm padrão embutido.
PREVIEW_URL_BASE=
SITE_URL_BASE=
