# Copie para .env.local e preencha com valores reais. NUNCA commite
# .env.local nem .env — só este arquivo de exemplo entra no git.

# Postgres (Supabase). DATABASE_URL_DIRECT é opcional (migrações preferem
# conexão direta, sem pooler); sem ela, cai para DATABASE_URL.
DATABASE_URL=
DATABASE_URL_DIRECT=
# Usado só pelos testes automatizados — pode apontar pro mesmo banco acima
# (os testes rodam num schema Postgres isolado, "test").
DATABASE_URL_TEST=

# Supabase Storage — fotos dos casais. Sem esta chave o envio de fotos fica
# desligado (o painel some da tela do casal e o site mostra as imagens de
# exemplo); nada mais quebra.
#   Onde pegar: Supabase → Project Settings → API → service_role
#   É chave de SERVIDOR: nunca use prefixo NEXT_PUBLIC_, nunca vá para o cliente.
# Depois de preencher, rode uma vez: npm run setup:storage
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: só se o Storage estiver noutro projeto. Vazio = derivado do
# DATABASE_URL (o usuário do pooler é postgres.<ref>).
SUPABASE_URL=

# Segredo usado para assinar os cookies de sessão (admin e casal). Gere um
# valor aleatório forte, ex: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar este valor derruba todas as sessões ativas (login de novo).
ADMIN_SESSION_SECRET=

# AbacatePay (pagamento PIX). Chave do painel AbacatePay — use uma chave de
# teste (abc_dev_...) em desenvolvimento, nunca a de produção fora da Vercel.
ABACATEPAY_API_KEY=
# Opcional: mesmo valor configurado no webhook do painel AbacatePay.
ABACATEPAY_WEBHOOK_SECRET=

# Em produção, defina a URL pública (ex: https://enlace.com.br) para os
# links de retorno do pagamento e de redefinição de senha.
NEXT_PUBLIC_SITE_URL=

# Envio de e-mail (redefinição de senha) via Resend. Sem a chave, o
# "esqueci minha senha" cai no WhatsApp. RESET_EMAIL_FROM precisa de um
# domínio verificado no Resend (ex: "Enlace <nao-responda@enlace.com.br>").
RESEND_API_KEY=
RESET_EMAIL_FROM=

# Qual transporte manda: "resend" ou "gmail". Vazia = precedência padrão,
# em que o Gmail ganha quando os dois estão preenchidos.
#
# Use ao MIGRAR do Gmail para o Resend: sem ela, pôr a RESEND_API_KEY com as
# variáveis do Gmail ainda preenchidas não troca nada — os e-mails continuam
# saindo pelo Gmail, sem erro e sem aviso.
EMAIL_TRANSPORT=

# --- Gmail SMTP (temporário, enquanto não há domínio próprio) ---
# Tem prioridade sobre o Resend quando preenchido, a menos que EMAIL_TRANSPORT
# diga o contrário. GMAIL_APP_PASSWORD é uma
# "Senha de app" (16 letras) de myaccount.google.com/apppasswords, NÃO a senha
# da conta — exige verificação em 2 etapas. Limite ~500 destinatários/dia.
# Teste com: node scripts/test-email.mjs seu@email.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Nome que aparece como remetente (padrão "Enlace").
MAIL_FROM_NAME=

# Segredo do Vercel Cron, que dispara o resumo semanal (segunda, 8h de
# Brasília — ver vercel.json). SEM ELE A ROTA RESPONDE 503 E NADA É ENVIADO,
# de propósito: uma rota pública que dispara e-mail para todos os casais
# ativos é um canhão de spam com URL.
#
# Gere um valor aleatório e ponha o MESMO em Settings > Environment Variables
# na Vercel. A Vercel manda esse valor sozinha no cabeçalho Authorization —
# não há nada a configurar do outro lado. Exige plano Pro.
CRON_SECRET=
